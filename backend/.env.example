# Copy to backend/.env.local for development. Never commit real keys.
GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional: Sarvam Bulbul v3 takes priority for Hindi and English.
# Otherwise Edge neural voices are used for all four languages.
SARVAM_API_KEY=
ALLOWED_ORIGINS=
