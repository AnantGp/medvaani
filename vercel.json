{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash scripts/build_vercel.sh",
  "outputDirectory": "flutter_app/build/web",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "backend/**",
      "excludeFiles": "{.git/**,.impeccable/**,docs/**,flutter_app/**,backend/.local/**,backend/.env*,backend/*.db,backend/test*,backend/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index.py"},
    {"source": "/((?!api/).*)", "destination": "/index.html"}
  ]
}
